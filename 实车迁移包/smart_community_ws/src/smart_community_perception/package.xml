<?xml version="1.0"?>
<package format="3">
  <name>smart_community_perception</name>
  <version>0.1.0</version>
  <description>ROS 2 perception nodes for the smart community simulation.</description>
  <maintainer email="team@example.com">Smart Community Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>smart_community_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- Install ultralytics separately in ROS2 Python environment. -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
